<mvc:View xmlns:chart="sap.fe.macros.chart" controllerName="captestmvc.project2.controller.firstview"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt">
    <Page id="page" title="{i18n>title}">
    		<tnt:ToolHeader id="shellLikeToolHeader" class="sapUiTinyMargin">
			<Button id="_IDGenButton" icon="sap-icon://menu2" type="Transparent" tooltip="Menu" press=".onCollapseExpandPress" >
				<layoutData>
					<OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData" priority="NeverOverflow"/>
				</layoutData>
			</Button>
			<Image id="_IDGenImage" src="test-resources/sap/tnt/images/SAP_Logo.png" decorative="false" press=".onLogoPressed" tooltip="SAP Logo" width="60px" height="30px">
				<layoutData>
					<OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData1" priority="NeverOverflow"/>
				</layoutData>
			</Image>
			<Title text="Prоduct Name" wrapping="false" id="productName">
				<layoutData>
					<OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData2" priority="Disappear"/>
				</layoutData>
			</Title>
			<Text text="Second title" wrapping="false" id="secondTitle">
				<layoutData>
					<OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData3" priority="Disappear"/>
				</layoutData>
			</Text>
			<ToolbarSpacer id="_IDGenToolbarSpacer" />
			<SearchField width="25rem" id="searchField">
				<layoutData>
					<OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData4" priority="Low" group="1"/>
				</layoutData>
			</SearchField>
			<Button visible="false" icon="sap-icon://search" type="Transparent" id="searchButton" tooltip="Search"/>
			<OverflowToolbarButton id="_IDGenOverflowToolbarButton1" icon="sap-icon://da" type="Transparent" tooltip="Joule" text="Joule">
				<layoutData>
					<OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData5" group="2"/>
				</layoutData>
			</OverflowToolbarButton>
			<OverflowToolbarButton id="_IDGenOverflowToolbarButton2" icon="sap-icon://source-code" type="Transparent" tooltip="Action 1" text="Action 1">
				<layoutData>
					<OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData6" group="2"/>
				</layoutData>
			</OverflowToolbarButton>
			<OverflowToolbarButton id="_IDGenOverflowToolbarButton3" icon="sap-icon://card" type="Transparent" tooltip="Action 2" text="Action 2">
				<layoutData>
					<OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData7" group="2"/>
				</layoutData>
			</OverflowToolbarButton>
			<OverflowToolbarButton id="_IDGenOverflowToolbarButton4" icon="sap-icon://action-settings" type="Transparent" text="Settings"/>
			<Button id="_IDGenButton1" icon="sap-icon://bell" type="Transparent" tooltip="Notification">
				<layoutData>
					<OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData8" priority="NeverOverflow"/>
				</layoutData>
			</Button>
			<tnt:ToolHeaderUtilitySeparator id="_IDGenToolHeaderUtilitySeparator"/>
			<OverflowToolbarButton id="_IDGenOverflowToolbarButton5" icon="sap-icon://grid" type="Transparent" text="My Products" tooltip="My Products"/>
			<Avatar id="_IDGenAvatar" src="test-resources/sap/tnt/images/Woman_avatar_01.png" displaySize="XS" press=".onAvatarPressed" tooltip="Profile">
				<layoutData>
					<OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData9" priority="NeverOverflow"/>
				</layoutData>
			</Avatar>
		</tnt:ToolHeader>
<HBox id="_IDGenHBox" >
<VBox id="_IDGenVBox1" >
<!--Side Navigation-->
		<tnt:SideNavigation id="sideNavigation" selectedKey="walked" expanded="true">
			<tnt:NavigationList id="_IDGenNavigationList">
				<tnt:NavigationListItem id="_IDGenNavigationListItem1" text="Home" icon="sap-icon://home" />
				<tnt:NavigationListGroup id="_IDGenNavigationListGroup" text="New">
					<tnt:NavigationListItem id="_IDGenNavigationListItem2" text="Add Books" icon="sap-icon://people-connected" press=".onAddBooks" visible="true" />
					<tnt:NavigationListItem id="_IDGenNavigationListItem3" text="Building" icon="sap-icon://building" >
						<tnt:NavigationListItem id="_IDGenNavigationListItem4" text="Office 01" />
						<tnt:NavigationListItem id="_IDGenNavigationListItem5" text="Office 02" />
					</tnt:NavigationListItem>
					<tnt:NavigationListItem id="_IDGenNavigationListItem6" text="Mileage" icon="sap-icon://mileage" >
						<tnt:NavigationListItem id="_IDGenNavigationListItem7" text="Driven" />
						<tnt:NavigationListItem text="Walked" id="walked" />
					</tnt:NavigationListItem>
				</tnt:NavigationListGroup>
				<tnt:NavigationListGroup id="_IDGenNavigationListGroup1" text="Recently used">
					<tnt:NavigationListItem id="_IDGenNavigationListItem8" text="View Books" icon="sap-icon://kpi-managing-my-area" press=".onViewBooks" visible="true" />
					<tnt:NavigationListItem id="_IDGenNavigationListItem9" text="Edit Books" icon="sap-icon://edit" press=".onEditBooks" visible="true"/>
					<tnt:NavigationListItem id="_IDGenNavigationListItem10" text="Map" icon="sap-icon://map-2" />
				</tnt:NavigationListGroup>
				<tnt:NavigationListGroup id="_IDGenNavigationListGroup2" text="Restricted" enabled="false">
					<tnt:NavigationListItem id="_IDGenNavigationListItem11" text="Running" icon="sap-icon://physical-activity" />
					<tnt:NavigationListItem id="_IDGenNavigationListItem12" text="Scissors" icon="sap-icon://scissors" />
				</tnt:NavigationListGroup>
				<tnt:NavigationListItem id="_IDGenNavigationListItem13" text="Transport" icon="sap-icon://passenger-train" />
			</tnt:NavigationList>
			<tnt:fixedItem>
				<tnt:NavigationList id="_IDGenNavigationList1">
					<tnt:NavigationListItem id="_IDGenNavigationListItem14" text="Bar Chart" icon="sap-icon://bar-chart" />
					<tnt:NavigationListItem id="_IDGenNavigationListItem15" selectable="false" href="https://sap.com" target="_blank" text="External Link" icon="sap-icon://attachment" />
					<tnt:NavigationListItem id="_IDGenNavigationListItem16" selectable="false" href="https://sap.com" target="_top" text="External Link _top" icon="sap-icon://attachment" />
					<tnt:NavigationListItem id="_IDGenNavigationListItem17" text="Compare" icon="sap-icon://compare" />
				</tnt:NavigationList>
			</tnt:fixedItem>
		</tnt:SideNavigation>
        </VBox>
        <VBox id="_IDGenVBox2" >

<!--Panel placing-->
<Panel id="_IDGenPanel1"  class="sapUiResponsiveMargin" accessibleRole="Region" width="60rem" visible="false">
		<headerToolbar>
			<OverflowToolbar id="_IDGenOverflowToolbar">
				<Title id="_IDGenTitle" text="Panel with picture"/>
			</OverflowToolbar>
		</headerToolbar>

    <Breadcrumbs id="bc" currentLocationText="Add New Item" visible="false">
    <Link id="lnk" text="Master"></Link>
    </Breadcrumbs>
    <HBox id="hb1">
    <VBox id="vb1">
    <Label id="lb1" text="Title"></Label>
    <Input id="inp1" placeholder="Enter your Title"> </Input>
    </VBox>
      <VBox id="vb2">
            <Label id="lb2" text="Author"></Label>
            <Input id="inp2" placeholder="Enter the Author"> </Input>
    </VBox>
      <VBox id="vb3">
            <Label id="lb3" text="Price"></Label>
            <Input id="inp3" placeholder="Enter the Price"> </Input>
    </VBox>
        </HBox>
    <HBox id="hb2">
      <VBox id="vb4">
            <Label id="lb4" text="Stock"></Label>
            <Input id="inp4" placeholder="Enter the Stock"> </Input>
    </VBox>
    <VBox id="vb5">
            <Label id="lb5" text="Location"></Label>
            <Input id="inp5" placeholder="Enter the Location"> </Input>
    </VBox>
    <VBox id="vb6">
            <Label id="lb6" text="Genre"></Label>
            <Input id="inp6" placeholder="Enter the Genre"> </Input>
    </VBox>
    </HBox>
    <HBox id="hb3">
    <VBox id="vb7">
    <Button id="submit" text="Submit" press="Submit"></Button>
    </VBox>
    </HBox>
    </Panel>
    <Panel id="_IDGenPanel2"  class="sapUiResponsiveMargin" accessibleRole="Region" width="60rem" visible="false">
		<headerToolbar>
			<OverflowToolbar id="_IDGenOverflowToolbar2">
				<Title id="_IDGenTitle2" text="View Books"/>
			</OverflowToolbar>
		</headerToolbar>
<!--Using Table-->
<Table id="table" items="{/Books}">
<columns>

<Column id="_IDGenColumn1">
<Text id="_IDGenText" text="Title"></Text>
</Column>
<Column id="_IDGenColumn2">
<Text id="_IDGenText1" text="Authr"></Text>
</Column>
<Column id="_IDGenColumn3">
<Text id="_IDGenText2" text="Price"></Text>
</Column>
<Column id="_IDGenColumn4">
<Text id="_IDGenText3" text="Stock"></Text>
</Column>
<Column id="_IDGenColumn5">
<Text id="_IDGenText4" text="Location"></Text>
</Column>
<Column id="_IDGenColumn6">
<Text id="_IDGenText5" text="Genre"></Text>
</Column>
<Column id="_IDGenColumn7">
<Text id="_IDGenText6" text="Action"></Text>
</Column>
</columns>
		<items>
        <ColumnListItem id="_IDGenColumnListItem" vAlign="Middle">
				<cells>
					<Text id="text1" text="{title}"></Text>
                    <Text id="text2" text="{author}"></Text>
                    <Text id="text3" text="{Price}"></Text>
                    <Text id="text4" text="{stock}"></Text>
                    <Text id="text5" text="{location}"></Text>
                    <Text id="text6" text="{genre}"></Text>
					<Button id="Button" text="..." press=".onActionDel($event,this)"></Button>
					<!--<Text id="_IDGenText6"
						//text="{SupplierName}" />
					//<Text id="_IDGenText7"
						text="{Width} x {Depth} x {Height} {DimUnit}" /> 
					<ObjectNumber id="_IDGenObjectNumber"
						number="{WeightMeasure}"
						unit="{WeightUnit}"
						state="{
							parts: [
								{path: 'WeightMeasure'},
								{path: 'WeightUnit'}
							],
							formatter: '.formatter.weightState'
						}" />
					<ObjectNumber id="_IDGenObjectNumber1"
						number="{
							parts:[{path:'Price'},{path:'CurrencyCode'}],
							type: 'sap.ui.model.type.Currency',
							formatOptions: {showMeasure: false}
						}"
						unit="{CurrencyCode}" /> -->
				</cells>
			</ColumnListItem>
		</items>
</Table>
    </Panel>
	<!--Panel 2 for ediing-->
	<Panel id="_IDGenPanel3"  class="sapUiResponsiveMargin" accessibleRole="Region" width="60rem" visible="false">
		<headerToolbar>
			<OverflowToolbar id="_IDGenOverflowToolbar3">
				<Title id="_IDGenTitle3" text="Panel with picture"/>
			</OverflowToolbar>
		</headerToolbar>
    <HBox id="hb4">
	<VBox id="vbox1">
    <Label id="itemlbl" text="ItemCode"></Label>
    <Input id="itemCode" placeholder="Itemcode" editable="false" > </Input>
    </VBox>
    <VBox id="vb9">
    <Label id="lb7" text="Title"></Label>
    <Input id="inp7" placeholder="Enter your Title"> </Input>
    </VBox>
      <VBox id="vb8">
            <Label id="lb9" text="Author"></Label>
            <Input id="inp9" placeholder="Enter the Author"> </Input>
    </VBox>
      <VBox id="vb10">
            <Label id="lb10" text="Price"></Label>
            <Input id="inp10" placeholder="Enter the Price"> </Input>
    </VBox>
        </HBox>
    <HBox id="hb11">
      <VBox id="vb11">
            <Label id="lb12" text="Stock"></Label>
            <Input id="inp12" placeholder="Enter the Stock"> </Input>
    </VBox>
    <VBox id="vb13">
            <Label id="lb13" text="Location"></Label>
            <Input id="inp13" placeholder="Enter the Location"> </Input>
    </VBox>
    <VBox id="vb14">
            <Label id="lb15" text="Genre"></Label>
            <Input id="inp15" placeholder="Enter the Genre"> </Input>
    </VBox>
    </HBox>
    <HBox id="hb16">
    <VBox id="vb16">
    <Button id="submit1" text="Submit" press=".onEdit"></Button>
    </VBox>
    </HBox>
    </Panel>
    </VBox>
    </HBox>
    </Page>
</mvc:View>